<?xml version="1.0"?>
<sdf version="1.6">
  <model name="perception_test_camera">
    <static>true</static>
    <pose>0 0 1 0 0 0</pose>
    <link name="camera_link">
      <sensor name="perception_test_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="perception_test_camera">
          <horizontal_fov>1.0123</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.01</near><far>100</far></clip>
        </camera>
        <plugin name="perception_test_camera_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
          <cameraName>perception_test_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
