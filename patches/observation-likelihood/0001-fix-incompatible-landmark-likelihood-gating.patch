diff --git a/source/tests/component/modeling/state_estimation/ObservationModelGate_ComponentTest.cpp b/source/tests/component/modeling/state_estimation/ObservationModelGate_ComponentTest.cpp
new file mode 100644
index 00000000..c54072ce
--- /dev/null
+++ b/source/tests/component/modeling/state_estimation/ObservationModelGate_ComponentTest.cpp
@@ -0,0 +1,254 @@
+#include "modeling/state_estimation/Localizer.h"
+#include "modeling/vision/visible_objects/VisibleGoalpost.h"
+#include "modeling/vision/visible_objects/VisibleLIntersection.h"
+#include "modeling/vision/visible_objects/VisibleTIntersection.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using itandroids_lib::math::Pose2D;
+using itandroids_lib::math::Vector3;
+using modeling::FieldDescription;
+using modeling::state_estimation::Localizer;
+using modeling::state_estimation::LocalizerParams;
+using modeling::vision::VisibleCross;
+using modeling::vision::VisibleFieldBoundary;
+using modeling::vision::VisibleFieldCenter;
+using modeling::vision::VisibleGoalpost;
+using modeling::vision::VisibleLIntersection;
+using modeling::vision::VisibleLine;
+using modeling::vision::VisibleTIntersection;
+
+namespace {
+
+enum class Kind { Goalpost, L, T };
+
+struct CaseResult {
+    double compatibleWeight;
+    double incompatibleWeight;
+};
+
+LocalizerParams params(int count) {
+    return LocalizerParams(count, 0.5, 2.0, 0.61, 0.0, 0.0, 0.0,
+                           true, false, false, false, false);
+}
+
+Vector3<double> robotObservation(const Vector3<double> &landmark, const Pose2D &pose,
+                                 double noiseX = 0.08, double noiseY = -0.05) {
+    const double dx = landmark.x - pose.translation.x;
+    const double dy = landmark.y - pose.translation.y;
+    const double c = std::cos(pose.rotation);
+    const double s = std::sin(pose.rotation);
+    return Vector3<double>(c * dx + s * dy + noiseX,
+                           -s * dx + c * dy + noiseY, 0.0);
+}
+
+void requireFiniteNormalized(Localizer &localizer, const std::string &label) {
+    double sum = 0.0;
+    for (int index = 0; index < localizer.getNumParticles(); ++index) {
+        const double weight = localizer.getParticles()[index].getWeight();
+        if (!std::isfinite(weight) || weight < 0.0) {
+            throw std::runtime_error(label + ": non-finite or negative particle weight");
+        }
+        sum += weight;
+    }
+    if (std::abs(sum - 1.0) > 1e-10) {
+        throw std::runtime_error(label + ": weights are not normalized");
+    }
+}
+
+void filter(Localizer &localizer, std::vector<VisibleGoalpost *> &goals,
+            std::vector<VisibleLIntersection *> &ls, std::vector<VisibleTIntersection *> &ts) {
+    std::vector<VisibleLine *> lines;
+    std::vector<VisibleCross *> crosses;
+    representations::Joints joints;
+    localizer.filter(1.0, goals, lines, ls, ts, crosses,
+                     static_cast<VisibleFieldCenter *>(nullptr),
+                     static_cast<VisibleFieldBoundary *>(nullptr), joints);
+}
+
+CaseResult runLandmarkCase(Kind kind, bool hugeFiniteObservation = false) {
+    FieldDescription field;
+    representations::RobotType robot;
+    Localizer localizer(robot, field, params(2));
+    const Pose2D compatiblePose(0.12, 0.35, -0.25);
+
+    Vector3<double> mapLandmark;
+    if (kind == Kind::Goalpost) mapLandmark = field.getGoalPosts().front();
+    if (kind == Kind::L) mapLandmark = field.getLintersections().front();
+    if (kind == Kind::T) mapLandmark = field.getTintersections().front();
+    const Vector3<double> observation = hugeFiniteObservation
+        ? Vector3<double>(1.0e6, -1.0e6, 0.0)
+        : robotObservation(mapLandmark, compatiblePose);
+    const double observedBearing = std::atan2(observation.y, observation.x);
+    const double expectedBearingFromWrongPose = std::atan2(mapLandmark.y - 30.0, mapLandmark.x - 30.0);
+    const Pose2D incompatiblePose(expectedBearingFromWrongPose - observedBearing - M_PI, 30.0, 30.0);
+    localizer.getParticles()[0].setPose(compatiblePose);
+    localizer.getParticles()[1].setPose(incompatiblePose);
+    localizer.getParticles()[0].setWeight(0.5);
+    localizer.getParticles()[1].setWeight(0.5);
+
+    std::vector<VisibleGoalpost *> goals;
+    std::vector<VisibleLIntersection *> ls;
+    std::vector<VisibleTIntersection *> ts;
+    VisibleGoalpost goal(observation);
+    VisibleLIntersection l(observation);
+    VisibleTIntersection t(observation);
+    if (kind == Kind::Goalpost) goals.push_back(&goal);
+    if (kind == Kind::L) ls.push_back(&l);
+    if (kind == Kind::T) ts.push_back(&t);
+    filter(localizer, goals, ls, ts);
+    requireFiniteNormalized(localizer, "landmark case");
+    return {localizer.getParticles()[0].getWeight(), localizer.getParticles()[1].getWeight()};
+}
+
+void checkZeroAndMissing() {
+    FieldDescription field;
+    representations::RobotType robot;
+    Localizer localizer(robot, field, params(2));
+    localizer.getParticles()[0].setWeight(0.5);
+    localizer.getParticles()[1].setWeight(0.5);
+    std::vector<VisibleGoalpost *> goals;
+    std::vector<VisibleLIntersection *> ls;
+    std::vector<VisibleTIntersection *> ts;
+    filter(localizer, goals, ls, ts);
+    requireFiniteNormalized(localizer, "zero observations");
+    if (localizer.getParticles()[0].getWeight() != 0.5 ||
+        localizer.getParticles()[1].getWeight() != 0.5) {
+        throw std::runtime_error("zero observations changed particle weights");
+    }
+}
+
+void checkMirroredFinite() {
+    FieldDescription field;
+    representations::RobotType robot;
+    Localizer localizer(robot, field, params(2));
+    const Pose2D pose(0.0, 0.8, 0.5);
+    localizer.getParticles()[0].setPose(pose);
+    localizer.getParticles()[1].setPose(Pose2D(M_PI, -0.8, -0.5));
+    localizer.getParticles()[0].setWeight(0.5);
+    localizer.getParticles()[1].setWeight(0.5);
+    const auto observation = robotObservation(field.getLintersections().front(), pose);
+    VisibleLIntersection l(observation);
+    std::vector<VisibleGoalpost *> goals;
+    std::vector<VisibleLIntersection *> ls{&l};
+    std::vector<VisibleTIntersection *> ts;
+    filter(localizer, goals, ls, ts);
+    requireFiniteNormalized(localizer, "mirrored hypothesis");
+}
+
+void checkResamplingStability() {
+    FieldDescription field;
+    representations::RobotType robot;
+    Localizer localizer(robot, field, params(1000));
+    const Pose2D pose(0.12, 0.35, -0.25);
+    VisibleGoalpost goal(robotObservation(field.getGoalPosts().front(), pose));
+    VisibleLIntersection l(robotObservation(field.getLintersections().front(), pose));
+    VisibleTIntersection t(robotObservation(field.getTintersections().front(), pose));
+    std::vector<VisibleGoalpost *> goals{&goal};
+    std::vector<VisibleLIntersection *> ls{&l};
+    std::vector<VisibleTIntersection *> ts{&t};
+    for (int index = 0; index < localizer.getNumParticles(); ++index) {
+        const double fraction = static_cast<double>(index) / localizer.getNumParticles();
+        localizer.getParticles()[index].setPose(
+            Pose2D(-M_PI + 2.0 * M_PI * fraction, -4.5 + 9.0 * fraction,
+                   -3.0 + 6.0 * std::fmod(7.0 * fraction, 1.0)));
+        localizer.getParticles()[index].setWeight(1.0 / localizer.getNumParticles());
+    }
+    // Localizer resamples after its fixed 30-update interval. Crossing that
+    // boundary catches non-finite or non-normalized post-resample weights.
+    for (int iteration = 0; iteration < 35; ++iteration) {
+        filter(localizer, goals, ls, ts);
+        requireFiniteNormalized(localizer, "post-resample update");
+    }
+}
+
+double benchmarkP95() {
+    std::vector<double> samples;
+    samples.reserve(200);
+    for (int batch = 0; batch < 10; ++batch) {
+        FieldDescription field;
+        representations::RobotType robot;
+        Localizer localizer(robot, field, params(1000));
+        const Pose2D pose(0.12, 0.35, -0.25);
+        VisibleGoalpost goal(robotObservation(field.getGoalPosts().front(), pose));
+        VisibleLIntersection l(robotObservation(field.getLintersections().front(), pose));
+        VisibleTIntersection t(robotObservation(field.getTintersections().front(), pose));
+        std::vector<VisibleGoalpost *> goals{&goal};
+        std::vector<VisibleLIntersection *> ls{&l};
+        std::vector<VisibleTIntersection *> ts{&t};
+        for (int iteration = 0; iteration < 20; ++iteration) {
+            for (int index = 0; index < localizer.getNumParticles(); ++index) {
+                const double fraction = static_cast<double>(index) / localizer.getNumParticles();
+                localizer.getParticles()[index].setPose(
+                    Pose2D(-M_PI + 2.0 * M_PI * fraction, -4.5 + 9.0 * fraction,
+                           -3.0 + 6.0 * std::fmod(7.0 * fraction, 1.0)));
+                localizer.getParticles()[index].setWeight(1.0 / localizer.getNumParticles());
+            }
+            const auto begin = std::chrono::steady_clock::now();
+            filter(localizer, goals, ls, ts);
+            const auto end = std::chrono::steady_clock::now();
+            samples.push_back(std::chrono::duration<double, std::milli>(end - begin).count());
+            requireFiniteNormalized(localizer, "benchmark update");
+        }
+    }
+    std::sort(samples.begin(), samples.end());
+    return samples[static_cast<std::size_t>(0.95 * (samples.size() - 1))];
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    if (argc != 2 || (std::string(argv[1]) != "unpatched" && std::string(argv[1]) != "patched")) {
+        std::cerr << "usage: ObservationModelGate_ComponentTest {unpatched|patched}\n";
+        return 2;
+    }
+    const bool patched = std::string(argv[1]) == "patched";
+    try {
+        checkZeroAndMissing();
+        checkMirroredFinite();
+        checkResamplingStability();
+        const CaseResult goal = runLandmarkCase(Kind::Goalpost);
+        const CaseResult l = runLandmarkCase(Kind::L);
+        const CaseResult t = runLandmarkCase(Kind::T);
+        const CaseResult invalid = runLandmarkCase(Kind::L, true);
+        const CaseResult lRepeat = runLandmarkCase(Kind::L);
+        if (std::abs(l.compatibleWeight - lRepeat.compatibleWeight) > 1e-12) {
+            throw std::runtime_error("deterministic rerun changed L-case weight");
+        }
+        for (const auto &entry : {goal, l, t}) {
+            if (patched && !(entry.compatibleWeight > entry.incompatibleWeight)) {
+                throw std::runtime_error("patched gate did not rank compatible hypothesis first");
+            }
+            if (!patched && !(entry.incompatibleWeight > entry.compatibleWeight)) {
+                throw std::runtime_error("unpatched baseline did not reproduce neutral-gate defect");
+            }
+        }
+        if (std::abs(invalid.compatibleWeight + invalid.incompatibleWeight - 1.0) > 1e-10) {
+            throw std::runtime_error("finite-invalid observation broke normalization");
+        }
+        const double p95 = benchmarkP95();
+        std::cout << std::fixed << std::setprecision(9)
+                  << "{\"status\":\"PASS\",\"mode\":\"" << argv[1]
+                  << "\",\"goal_compatible_weight\":" << goal.compatibleWeight
+                  << ",\"goal_incompatible_weight\":" << goal.incompatibleWeight
+                  << ",\"l_compatible_weight\":" << l.compatibleWeight
+                  << ",\"l_incompatible_weight\":" << l.incompatibleWeight
+                  << ",\"t_compatible_weight\":" << t.compatibleWeight
+                  << ",\"t_incompatible_weight\":" << t.incompatibleWeight
+                  << ",\"finite_invalid_weight_sum\":"
+                  << invalid.compatibleWeight + invalid.incompatibleWeight
+                  << ",\"updates\":200,\"particles\":1000,\"resampling_updates\":35"
+                  << ",\"latency_p95_ms\":" << p95 << "}\n";
+    } catch (const std::exception &error) {
+        std::cerr << "FAIL: " << error.what() << "\n";
+        return 1;
+    }
+    return 0;
+}
